---
import BaseLayout from '../../layouts/BaseLayout.astro';
const categories = {
  'plc-hmi': { title: 'PLC and HMI', description: 'Programmable control and industrial visualization requirements.', image: '/Nubelon/images/generated/nubelon-plc-hmi.png', items: ['PLC systems', 'HMI panels', 'Remote I/O and networking'] },
  'drives-motion': { title: 'Drives and Motion', description: 'Variable frequency drives, motor control and motion applications.', image: '/Nubelon/images/generated/nubelon-control-products.png', items: ['Variable frequency drives', 'Motor starters and control', 'Motion and positioning'] },
  'switchgear-protection': { title: 'Switchgear and Protection', description: 'Switching, protection and power distribution components.', image: '/Nubelon/images/generated/nubelon-control-products.png', items: ['Circuit protection', 'Contactors and relays', 'Switching and distribution'] },
  instrumentation: { title: 'Instrumentation and Measurement', description: 'Measurement and analytics equipment for process applications.', image: '/Nubelon/images/generated/nubelon-middle-east-industry.png', items: ['Process measurement', 'Analytical instruments', 'Signals and accessories'] }
};
export function getStaticPaths() { return Object.entries(categories).map(([category, data]) => ({ params: { category }, props: data })); }
const { title, description, image, items } = Astro.props;
---
<BaseLayout title={`${title} | Nubelon Technology`} description={`${title} for industrial automation projects in the Middle East.`}>
  <header class="nav"><div class="wrap nav-inner"><a class="logo" href="/Nubelon/">NUBE<span>LON</span></a><nav class="nav-links"><a href="/Nubelon/products/">Products</a><a href="/Nubelon/services/">Services</a><a href="/Nubelon/brands/">Brands</a><a class="btn" href="/Nubelon/contact/">Request a Quote</a></nav></div></header>
  <main>
    <section class="hero"><div class="wrap"><div class="eyebrow">Product category</div><h1>{title}</h1><p>{description}</p><a class="btn" href="/Nubelon/contact/">Request product information ↗</a></div></section>
    <section><div class="wrap category-intro"><img class="category-image" src={image} alt={`AI concept image for ${title}`} /><div><div class="eyebrow">Category scope</div><h2>Make the buying task<br/>clearer.</h2><p>Use this category as a starting point for a part number, BOM or technical brief. We will confirm exact models, documentation and regional availability with you.</p><a class="text-link" href="/Nubelon/contact/">Discuss your requirement →</a></div></div></section>
    <section class="band"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Typical requirements</div><h2>Organized for<br/>project conversations.</h2></div><p>These are capability groupings, not a confirmed stock list. Product data will be added as the catalog is verified.</p></div><div class="cards">{items.map((item, index) => <article class="card"><span class="num">0{index + 1}</span><h3>{item}</h3><p>Selection support, compatibility checks and documentation routing are available on request.</p></article>)}</div></div></section>
    <section class="contact"><div class="wrap"><div class="eyebrow" style="color:#fff">Need a specific part?</div><h2 class="contact-title">Send a part number or BOM.</h2><p>Our sales team will confirm the right product conversation for your project and region.</p><a class="btn" href="/Nubelon/contact/">Start an enquiry ↗</a></div></section>
  </main>
  <footer><div class="wrap footer-row"><span>Nubelon Technology (Xiamen) Co., Ltd.</span><span>{title}</span><span>nubelon@163.com</span></div></footer>
</BaseLayout>
<style>
  .nav-inner{display:flex;align-items:center;justify-content:space-between;width:100%}.category-intro{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center}.category-image{width:100%;height:360px;object-fit:cover;border:1px solid var(--line)}.category-intro h2{font:600 clamp(32px,4vw,52px)/1 'Space Grotesk';letter-spacing:-.05em;margin:16px 0}.category-intro p{color:var(--muted);line-height:1.7;max-width:480px}.text-link{display:inline-block;margin-top:20px;font-weight:700}.contact-title{font:600 clamp(38px,5vw,68px)/1 'Space Grotesk';letter-spacing:-.06em;max-width:700px;margin:18px 0}@media(max-width:760px){.category-intro{display:block}.category-image{height:240px;margin-bottom:35px}}
</style>
