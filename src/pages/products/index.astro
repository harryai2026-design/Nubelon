---
import BaseLayout from '../../layouts/BaseLayout.astro';
const groups=[['industrial-control','Industrial control','PLCs, HMIs, control relays, contactors and automation components.','/Nubelon/images/generated/nubelon-plc-hmi.png'],['drives-motion','Drives and motion','Variable frequency drives, motor control and motion applications.','/Nubelon/images/generated/nubelon-control-products.png'],['switchgear-protection','Switchgear and protection','Switching, protection and power distribution components.','/Nubelon/images/generated/nubelon-control-products.png'],['instrumentation','Instrumentation and measurement','Measurement and analytics equipment for process applications.','/Nubelon/images/generated/nubelon-middle-east-industry.png']];
---
<BaseLayout title="Products | Nubelon Technology"><header class="nav"><div class="wrap nav-inner"><a class="logo" href="/Nubelon/">NUBE<span>LON</span></a><nav class="nav-links"><a href="/Nubelon/products/">Products</a><a href="/Nubelon/services/">Services</a><a href="/Nubelon/brands/">Brands</a><a class="btn" href="/Nubelon/contact/">Request a Quote</a></nav></div></header><main><section class="hero"><div class="wrap"><div class="eyebrow">Product portfolio</div><h1>Industrial control,<br/>specified clearly.</h1><p>Share a part number, BOM or technical requirement and we will route your request to the right product conversation.</p><a class="btn" href="/Nubelon/contact/">Send product requirements ↗</a></div></section><section><div class="wrap"><div class="section-head"><div><div class="eyebrow">Core categories</div><h2>Built for the<br/>buying task.</h2></div><p>Product data, availability and regional supply details will be added as the catalog is completed.</p></div><div class="cards">{groups.map(([slug,title,desc,image])=><article class="card"><img class="card-image" src={image} alt={`AI concept image for ${title}`} /><span class="num">{title}</span><h3>{title}</h3><p>{desc}</p><a href={`/Nubelon/products/${slug}/`}>Explore category →</a></article>)}</div></div></section></main><footer><div class="wrap footer-row"><span>Nubelon Technology (Xiamen) Co., Ltd.</span><span>Products · Services · Contact</span><span>nubelon@163.com</span></div></footer></BaseLayout><style>.nav-inner{display:flex;align-items:center;justify-content:space-between;width:100%}</style>
