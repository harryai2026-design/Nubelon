---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import { languages } from '../../../i18n/ui';
export function getStaticPaths(){return Object.keys(languages).map(lang=>({params:{lang},props:{lang}}));} const {lang}=Astro.props; const rtl=lang==='ar'; const brands=['ABB','Siemens','Schneider Electric','Hitachi Energy','Eaton','Emerson','Rockwell Automation','Endress+Hauser','Phoenix Contact','Weidmüller','Arteche'];
---
<BaseLayout title="Brands | Nubelon"><div dir={rtl?'rtl':'ltr'}><header class="nav"><div class="wrap"><a class="logo" href={`/${lang}/`}>NUBE<span>LON</span></a></div></header><main><section class="hero"><div class="wrap"><div class="eyebrow">{lang==='zh'?'品牌目录':rtl?'العلامات التجارية':'Portfolio brands'}</div><h1>{lang==='zh'?'面向工业项目的技术品牌。':rtl?'علامات تقنية للمشاريع الصناعية.':'Technology partners<br/>for industrial work.'}</h1><p>{lang==='zh'?'品牌授权、区域供应和产品范围将按文件逐项补充。':rtl?'سيتم التحقق من التفويض والتغطية الإقليمية لكل علامة.':'Authorization, regional supply and product scope will be verified per brand.'}</p></div></section><section><div class="wrap"><div class="brands">{brands.map(b=><div class="brand">{b}<small style="display:block;color:var(--muted);font:12px 'DM Sans';margin-top:9px">Portfolio listing · verification pending</small></div>)}</div></div></section></main><footer><div class="wrap footer-row"><span>Nubelon Technology (Xiamen) Co., Ltd.</span><span>Global enquiries</span><span>nubelon@163.com</span></div></footer></div></BaseLayout>
