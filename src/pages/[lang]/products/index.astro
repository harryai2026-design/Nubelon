---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages } from '../../../i18n/ui';
export function getStaticPaths(){return Object.keys(languages).map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props; const rtl=lang==='ar'; const t=lang==='zh'?['产品供应','为中东工业项目匹配合适的电控、仪表与自动化产品。','提交产品需求']:rtl?['توريد المنتجات','نوفر منتجات التحكم الكهربائي والأجهزة لمشاريع الصناعة في الشرق الأوسط.','أرسل متطلباتك']:['Product supply','Industrial electrical control, instrumentation and automation products for projects across the Middle East.','Send product requirements'];
---
<BaseLayout title={`${t[0]} | Nubelon`}><div dir={rtl?'rtl':'ltr'}><header class="nav"><div class="wrap" style="display:flex;align-items:center;justify-content:space-between;width:100%"><a class="logo" href={`/${lang}/`}>NUBE<span>LON</span></a><nav class="nav-links"><a href={`/${lang}/products/`}>{lang==='zh'?'产品':rtl?'المنتجات':'Products'}</a><a href={`/${lang}/services/`}>{lang==='zh'?'服务':rtl?'الخدمات':'Services'}</a><a href={`/${lang}/brands/`}>{lang==='zh'?'品牌':rtl?'العلامات':'Brands'}</a><a class="btn" href={`/${lang}/contact/`}>{t[2]}</a></nav></div></header><main><section class="hero"><div class="wrap"><div class="eyebrow">{t[0]}</div><h1>{lang==='zh'?'工业控制，清晰选型。':rtl?'تحكم صناعي، باختيار واضح.':'Industrial control,<br/>specified clearly.'}</h1><p>{t[1]}</p><a class="btn" href={`/${lang}/contact/`}>{t[2]} ↗</a></div></section><section><div class="wrap"><div class="cards"><article class="card"><span class="num">01</span><h3>{lang==='zh'?'工业控制元件':rtl?'مكونات التحكم الصناعي':'Industrial control components'}</h3><p>PLC, HMI, relays, contactors, drives and networking.</p></article><article class="card"><span class="num">02</span><h3>{lang==='zh'?'开关与保护':rtl?'المفاتيح والحماية':'Switchgear and protection'}</h3><p>Switching, protection and power distribution.</p></article><article class="card"><span class="num">03</span><h3>{lang==='zh'?'仪表与测量':rtl?'القياس والأجهزة':'Instrumentation and measurement'}</h3><p>Measurement and analytics for process applications.</p></article></div></div></section></main><footer><div class="wrap footer-row"><span>Nubelon Technology (Xiamen) Co., Ltd.</span><span>Global enquiries</span><span>nubelon@163.com</span></div></footer></div></BaseLayout>
