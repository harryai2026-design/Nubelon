---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import { languages } from '../../../i18n/ui';
export function getStaticPaths(){return Object.keys(languages).map(lang=>({params:{lang},props:{lang}}));} const {lang}=Astro.props; const rtl=lang==='ar'; const text=lang==='zh'?['联系与询价','提交料号、BOM、规格书或项目需求。','提交询价']:rtl?['التواصل وطلب عرض','أرسل رقم الجزء أو قائمة المواد أو متطلبات المشروع.','أرسل طلبك']:['Contact and quote','Send a part number, BOM, specification or project outline.','Request a quote'];
---
<BaseLayout title={`${text[0]} | Nubelon`}><div dir={rtl?'rtl':'ltr'}><header class="nav"><div class="wrap"><a class="logo" href={`/Nubelon/${lang}/`}>NUBE<span>LON</span></a></div></header><main><section class="hero"><div class="wrap"><div class="eyebrow">{text[0]}</div><h1>{lang==='zh'?'从技术需求开始。':rtl?'ابدأ بالموجز الفني.':'Bring us the<br/>technical brief.'}</h1><p>{text[1]}</p></div></section><section><div class="wrap" style="max-width:760px"><div class="eyebrow">Sales contact</div><h2 style="font:600 42px 'Space Grotesk'">Mr. Zhongyan Liu</h2><p style="color:var(--muted);line-height:1.8">Sales Director<br/>nubelon@163.com<br/>+86 13051108770<br/>WeChat: Nubelon_XM</p><a class="btn" href="mailto:nubelon@163.com">{text[2]} ↗</a></div></section></main><footer><div class="wrap footer-row"><span>Nubelon Technology (Xiamen) Co., Ltd.</span><span>Global enquiries</span><span>nubelon@163.com</span></div></footer></div></BaseLayout>
