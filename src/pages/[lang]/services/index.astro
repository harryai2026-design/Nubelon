---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import { languages } from '../../../i18n/ui';
export function getStaticPaths(){return Object.keys(languages).map(lang=>({params:{lang},props:{lang}}));} const {lang}=Astro.props; const rtl=lang==='ar'; const title=lang==='zh'?'工程服务':rtl?'الخدمات الهندسية':'Engineering services';
---
<BaseLayout title={`${title} | Nubelon`}><div dir={rtl?'rtl':'ltr'}><header class="nav"><div class="wrap"><a class="logo" href={`/Nubelon/${lang}/`}>NUBE<span>LON</span></a></div></header><main><section class="hero"><div class="wrap"><div class="eyebrow">{title}</div><h1>{lang==='zh'?'从系统设计到调试交付。':rtl?'من تصميم النظام إلى التشغيل التجريبي.':'From system design<br/>to commissioning.'}</h1><p>{lang==='zh'?'为工业控制、电气和测量项目提供技术支持。':rtl?'دعم فني لمشاريع التحكم والكهرباء والقياس.':'Technical project support for industrial control, electrical and measurement requirements.'}</p><a class="btn" href={`/Nubelon/${lang}/contact/`}>{lang==='zh'?'讨论项目':rtl?'ناقش مشروعك':'Discuss a project'} ↗</a></div></section><section><div class="wrap"><div class="cards"><article class="card"><span class="num">01</span><h3>System design</h3><p>Align products and control requirements with the project brief.</p></article><article class="card"><span class="num">02</span><h3>Installation</h3><p>Coordinate installation requirements and technical handover.</p></article><article class="card"><span class="num">03</span><h3>Commissioning</h3><p>Support testing, startup and commissioning planning.</p></article></div></div></section></main><footer><div class="wrap footer-row"><span>Nubelon Technology (Xiamen) Co., Ltd.</span><span>Global enquiries</span><span>nubelon@163.com</span></div></footer></div></BaseLayout>
