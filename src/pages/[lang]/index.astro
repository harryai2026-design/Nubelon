---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, copy } from '../../i18n/ui';
export function getStaticPaths() { return Object.keys(languages).map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: keyof typeof languages };
const t = copy[lang];
---
<BaseLayout title={`${lang === 'ar' ? 'Nubelon Technology | الأتمتة الصناعية' : lang === 'zh' ? 'Nubelon Technology | 工业自动化' : 'Nubelon Technology | Industrial Automation'}`}>
  <html lang={lang} dir={languages[lang].dir}>
  <header class="nav"><div class="wrap" style="display:flex;align-items:center;justify-content:space-between;width:100%"><a class="logo" href={`/Nubelon/${lang}/`}>NUBE<span>LON</span></a><nav class="nav-links"><a href={`/Nubelon/${lang}/#products`}>{lang === 'ar' ? 'المنتجات' : lang === 'zh' ? '产品' : 'Products'}</a><a href={`/Nubelon/${lang}/#services`}>{lang === 'ar' ? 'الخدمات' : lang === 'zh' ? '服务' : 'Services'}</a><a href={`/Nubelon/${lang}/#contact`}>{lang === 'ar' ? 'تواصل' : lang === 'zh' ? '联系' : 'Contact'}</a><a href="/Nubelon/en/">EN</a><a href="/Nubelon/ar/">عربي</a><a href="/Nubelon/zh/">中文</a></nav></div></header>
  <main><section class="hero"><div class="wrap"><div class="eyebrow">{t.eyebrow}</div><h1>{t.title}</h1><p>{t.intro}</p><div class="hero-actions"><a class="btn" href={`/Nubelon/${lang}/#contact`}>{t.project}</a><a class="btn alt" href={`/Nubelon/${lang}/#products`}>{t.products}</a></div></div></section><section id="products"><div class="wrap"><div class="section-head"><div><div class="eyebrow">{t.supply}</div><h2>{t.supplyTitle}</h2></div><p>{t.supplyText}</p></div><div class="cards"><article class="card"><span class="num">01 / CONTROL</span><h3>{lang === 'ar' ? 'التحكم الصناعي' : lang === 'zh' ? '工业控制' : 'Industrial control'}</h3><p>PLCs, HMIs, control components, drives and industrial networking.</p></article><article class="card"><span class="num">02 / POWER</span><h3>{lang === 'ar' ? 'المفاتيح والحماية' : lang === 'zh' ? '开关与保护' : 'Switchgear & protection'}</h3><p>Electrical control, switching, protection and power distribution.</p></article><article class="card"><span class="num">03 / MEASUREMENT</span><h3>{lang === 'ar' ? 'القياس والأجهزة' : lang === 'zh' ? '仪表与测量' : 'Instrumentation'}</h3><p>Measurement and analytics equipment for industrial applications.</p></article></div></div></section><section id="services" class="band"><div class="wrap"><div class="section-head"><div><div class="eyebrow">{t.services}</div><h2>{t.servicesTitle}</h2></div><p>System design, installation and commissioning support for project teams.</p></div></div></section><section id="contact" class="contact"><div class="wrap"><div class="eyebrow" style="color:#fff">Nubelon Technology</div><h2 style="font:600 clamp(38px,5vw,68px)/1 'Space Grotesk';letter-spacing:-.06em">{t.contact}</h2><a class="btn" href="mailto:nubelon@163.com">{t.contact}</a></div></section></main><footer><div class="wrap footer-row"><span>Nubelon Technology (Xiamen) Co., Ltd.</span><span>Middle East · Global enquiries</span><span>nubelon@163.com</span></div></footer>
  </html>
</BaseLayout>
