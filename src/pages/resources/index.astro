---
import BaseLayout from '../../layouts/BaseLayout.astro';
const resources=[['Product selection guide','A practical starting point for PLC, HMI, drives, protection and instrumentation enquiries.','Coming next'],['BOM and part-number checklist','The information that helps us review compatibility, alternatives and delivery scope.','Available on request'],['Project briefing template','Capture application, country, standards, timeline and commissioning context in one place.','Download will be added'],['Technical document request','Request datasheets, manuals, certificates or product documentation for a specific requirement.','Contact sales']];
---
<BaseLayout title="Resources | Nubelon Technology" description="Technical resources, product selection guidance and project briefing tools for industrial automation buyers.">
<header class="nav"><div class="wrap nav-inner"><a class="logo" href="/Nubelon/">NUBE<span>LON</span></a><nav class="nav-links"><a href="/Nubelon/products/">Products</a><a href="/Nubelon/services/">Services</a><a href="/Nubelon/brands/">Brands</a><a href="/Nubelon/industries/">Industries</a><a href="/Nubelon/solutions/">Solutions</a><a href="/Nubelon/resources/">Resources</a><a class="btn" href="/Nubelon/contact/">Request a Quote</a></nav></div></header>
<main><section class="hero"><div class="wrap"><div class="eyebrow">Technical resources</div><h1>Useful information<br/>for the next step.</h1><p>Selection notes, briefing tools and document requests will be organized here as the verified product catalog grows.</p><a class="btn" href="/Nubelon/contact/">Request a document ↗</a></div><img class="page-visual" src="/Nubelon/images/generated/nubelon-control-products.webp" alt="AI concept image of generic industrial control products" fetchpriority="high"/></section><section><div class="wrap"><div class="section-head"><div><div class="eyebrow">Resource library</div><h2>Prepare a better<br/>buying conversation.</h2></div><p>These initial resources are structured placeholders. Replace them with approved files, datasheets and case material before public launch.</p></div><div class="cards">{resources.map(([title,desc,status],i)=><article class="card"><span class="num">0{i+1}</span><h3>{title}</h3><p>{desc}</p><small>{status}</small></article>)}</div></div></section><section class="contact"><div class="wrap"><div class="eyebrow" style="color:#fff">Looking for a specific file?</div><h2 class="contact-title">Tell us the part number.</h2><p>We can route a document request to the sales conversation for your region.</p><a class="btn" href="/Nubelon/contact/">Make a request ↗</a></div></section></main><footer><div class="wrap footer-row"><span>Nubelon Technology (Xiamen) Co., Ltd.</span><span>Technical resources</span><span>nubelon@163.com</span></div></footer></BaseLayout>
<style>.nav-inner{display:flex;align-items:center;justify-content:space-between;width:100%}.card small{display:block;color:var(--red);font-weight:700;margin-top:24px}.contact-title{font:600 clamp(38px,5vw,68px)/1 'Space Grotesk';letter-spacing:-.06em;max-width:700px;margin:18px 0}.hero{position:relative;overflow:hidden}.page-visual{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.42;mix-blend-mode:normal;z-index:0}.hero:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,17,23,.96),rgba(11,17,23,.7) 48%,rgba(11,17,23,.3));z-index:1}.hero .wrap{position:relative;z-index:2}@media(max-width:760px){.page-visual{opacity:.28}}</style>
