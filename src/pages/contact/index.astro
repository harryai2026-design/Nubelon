---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact and Quote | Nubelon Technology">
  <header class="nav"><div class="wrap" style="display:flex;align-items:center;justify-content:space-between;width:100%"><a class="logo" href="/">NUBE<span>LON</span></a><nav class="nav-links"><a href="/products/">Products</a><a href="/services/">Services</a><a href="/brands/">Brands</a><a class="btn" href="/contact/">Request a Quote</a></nav></div></header>
  <main><section class="hero"><div class="wrap"><div class="eyebrow">Contact Nubelon</div><h1>Bring us the<br/>technical brief.</h1><p>Send a part number, BOM, specification or project outline. Our sales team will follow up with the right next step.</p></div></section><section><div class="wrap" style="display:grid;grid-template-columns:1fr 1fr;gap:50px"><div><div class="eyebrow">Sales contact</div><h2 style="font:600 42px 'Space Grotesk';letter-spacing:-.05em">Let’s start<br/>with context.</h2><p style="color:var(--muted);line-height:1.7">Nubelon Technology (Xiamen) Co., Ltd.<br/>Sales Director: Mr. Zhongyan Liu<br/><br/>Email: nubelon@163.com<br/>Mobile: +86 13051108770<br/>WeChat: Nubelon_XM</p></div><form style="background:#fff;border:1px solid var(--line);padding:28px;display:grid;gap:16px"><label>Name<input required name="name" placeholder="Your name" /></label><label>Work email<input required type="email" name="email" placeholder="you@company.com" /></label><label>Country or region<input name="region" placeholder="UAE, Saudi Arabia, ..." /></label><label>Project requirements<textarea name="message" rows="5" placeholder="Part number, BOM, application or project scope"></textarea></label><button class="btn" type="button">Send enquiry ↗</button><small style="color:var(--muted)">Form connection, file upload and CRM routing will be configured after the lead destination is confirmed.</small></form></div></section></main><footer><div class="wrap footer-row"><span>Nubelon Technology (Xiamen) Co., Ltd.</span><span>Room 2001, Software Park Phase III, Xiamen, China</span><span>nubelon@163.com</span></div></footer>
</BaseLayout>
<style>label{display:grid;gap:7px;font-size:13px;font-weight:700}input,textarea{font:inherit;border:1px solid var(--line);padding:13px;border-radius:3px}textarea{resize:vertical}@media(max-width:760px){.wrap[style*="grid-template-columns"]{display:block!important}.wrap[style*="grid-template-columns"] form{margin-top:35px}}</style>
