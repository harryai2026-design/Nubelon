---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Services | Nubelon Technology">
  <header class="nav"><div class="wrap nav-inner"><a class="logo" href="/Nubelon/">NUBE<span>LON</span></a><nav class="nav-links"><a href="/Nubelon/products/">Products</a><a href="/Nubelon/services/">Services</a><a href="/Nubelon/brands/">Brands</a><a class="btn" href="/Nubelon/contact/">Request a Quote</a></nav></div></header>
  <main><section class="hero"><div class="wrap"><div class="eyebrow">Engineering support</div><h1>From system design<br/>to commissioning.</h1><p>Technical project support for industrial control, electrical and measurement requirements.</p><a class="btn" href="/Nubelon/contact/">Discuss a project ↗</a></div></section><section><div class="wrap"><div class="service-feature"><img src="/Nubelon/images/generated/nubelon-engineering-commissioning.png" alt="AI concept image of engineers reviewing an electrical control cabinet" /><div><div class="eyebrow">Project path</div><h2>Support that follows<br/>the work.</h2><p>Move from a technical brief to a coordinated project conversation with design, installation and commissioning support.</p></div></div><div class="cards"><article class="card"><span class="num">01</span><h3>System design</h3><p>Align products and control requirements with the project brief.</p></article><article class="card"><span class="num">02</span><h3>Installation</h3><p>Coordinate installation requirements and technical handover.</p></article><article class="card"><span class="num">03</span><h3>Commissioning</h3><p>Support testing, startup and commissioning planning.</p></article></div></div></section></main><footer><div class="wrap footer-row"><span>Nubelon Technology (Xiamen) Co., Ltd.</span><span>Industrial automation engineering support</span><span>nubelon@163.com</span></div></footer>
</BaseLayout>
<style>.nav-inner{display:flex;align-items:center;justify-content:space-between;width:100%}.service-feature{display:grid;grid-template-columns:1.15fr .85fr;gap:52px;align-items:center;margin-bottom:55px}.service-feature img{width:100%;height:320px;object-fit:cover}.service-feature h2{font:600 clamp(32px,4vw,52px)/1 'Space Grotesk';letter-spacing:-.05em;margin:14px 0}.service-feature p{color:var(--muted);line-height:1.6}@media(max-width:760px){.service-feature{display:block}.service-feature img{margin-bottom:30px;height:240px}}</style>
