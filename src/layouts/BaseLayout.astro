---
const { title = 'Nubelon Technology | Industrial Automation', description = 'Industrial automation products and engineering support for the Middle East.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://nubelon.com');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://nubelon.com/images/nubelon-logo-generated.png" />
    <meta name="theme-color" content="#0b1117" />
    <link rel="icon" type="image/png" href="/Nubelon/images/nubelon-logo-generated.png" />
    <link rel="apple-touch-icon" href="/Nubelon/images/nubelon-logo-generated.png" />
  </head>
  <body><slot /></body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{--ink:#0b1117;--muted:#687582;--line:#dce3e8;--red:#ed1b2f;--blue:#153b5b;--paper:#f5f7f8}*{box-sizing:border-box}body{margin:0;color:var(--ink);font-family:'DM Sans',sans-serif;background:var(--paper)}a{color:inherit;text-decoration:none}.wrap{max-width:1180px;margin:auto;padding:0 28px}.nav{height:84px;display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid var(--line)}.nav-links{display:flex;gap:30px;align-items:center;font-size:14px}.logo{font-family:'Space Grotesk';font-weight:700;letter-spacing:-.04em;font-size:22px}.logo span{color:var(--red)}.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 20px;border-radius:4px;font-weight:700;font-size:14px;background:var(--red);color:white}.btn.alt{background:var(--ink)}.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--red);font-weight:700}.hero{background:var(--ink);color:#fff;padding:110px 0 100px;position:relative;overflow:hidden}.hero:after{content:'';position:absolute;width:520px;height:520px;border:1px solid #31404b;border-radius:50%;right:-120px;top:-180px;box-shadow:0 0 0 50px #111c24,0 0 0 51px #31404b,0 0 0 105px #111c24,0 0 0 106px #31404b}.hero .wrap{position:relative;z-index:2}.hero h1{font-family:'Space Grotesk';font-size:clamp(48px,7vw,88px);line-height:.96;letter-spacing:-.07em;max-width:850px;margin:22px 0}.hero p{color:#b8c4cc;max-width:520px;font-size:18px;line-height:1.6;margin:28px 0 36px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.hero .btn.alt{background:#fff;color:var(--ink)}.hero-image{position:absolute;right:0;bottom:0;width:45%;height:100%;object-fit:cover;opacity:.2;mix-blend-mode:screen;z-index:1}section{padding:92px 0}.section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:38px}.section-head h2{font:600 clamp(32px,4vw,52px)/1 'Space Grotesk';letter-spacing:-.05em;margin:12px 0 0}.section-head p{max-width:410px;color:var(--muted);line-height:1.6}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{background:#fff;border:1px solid var(--line);padding:28px;min-height:220px;display:flex;flex-direction:column;justify-content:space-between}.card-image{width:calc(100% + 56px);height:140px;object-fit:cover;margin:-28px -28px 24px}.card .num{font-family:'Space Grotesk';font-size:14px;color:var(--red)}.card h3{font:600 24px 'Space Grotesk';letter-spacing:-.04em}.card p{color:var(--muted);line-height:1.55;margin:0}.card a{font-weight:700;font-size:14px;margin-top:28px}.band{background:#dce9ef}.brands{display:flex;gap:12px;flex-wrap:wrap}.brand{background:#fff;border:1px solid #cbd6dc;padding:16px 22px;font:600 19px 'Space Grotesk'}.contact{background:var(--red);color:#fff}.contact p{color:#ffd8dc;max-width:480px;line-height:1.6}.contact .btn{background:#fff;color:var(--red)}footer{background:var(--ink);color:#fff;padding:32px 0;font-size:13px}.footer-row{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#9eabb4}@media(max-width:760px){.nav-links a:not(.btn){display:none}.hero{padding:76px 0}.hero-image{width:100%;opacity:.12}.cards{grid-template-columns:1fr}.section-head{display:block}.hero:after{right:-300px}.wrap{padding:0 20px}}
</style>
<style is:global>
  /* First-party Nubelon logo generated for this site; link text remains in the DOM for accessibility. */
  .logo { display:inline-block; width:164px; height:42px; color:transparent !important; font-size:0 !important; background-image:url('/Nubelon/images/nubelon-logo-generated.png') !important; background-position:center !important; background-size:contain !important; background-repeat:no-repeat !important; }
  .logo span { display:none; }
</style>
<style is:global>
body:has(.service-feature) .hero{background-image:linear-gradient(90deg,rgba(11,17,23,.96),rgba(11,17,23,.55)),url('/Nubelon/images/generated/nubelon-engineering-commissioning.png');background-size:cover;background-position:center}
body:has(.brand-scene) .hero{background-image:linear-gradient(90deg,rgba(11,17,23,.96),rgba(11,17,23,.55)),url('/Nubelon/images/generated/nubelon-middle-east-industry.png');background-size:cover;background-position:center}
body:has(.card-image) .hero{background-image:linear-gradient(90deg,rgba(11,17,23,.96),rgba(11,17,23,.55)),url('/Nubelon/images/generated/nubelon-control-products.png');background-size:cover;background-position:center}
body:has(.display-title) .brands{display:block;background:#fff url('/Nubelon/images/nubelon-business-scope-brands.png') center/contain no-repeat;min-height:390px;border:1px solid var(--line)}
body:has(.display-title) .brands{background-image:url('/Nubelon/images/nubelon-business-scope-brands-v2.png')}
body:has(.display-title) .brands .brand{display:none}
body:has(.brand-scene) .brands{display:block;background:#fff url('/Nubelon/images/nubelon-business-scope-brands.png') center/contain no-repeat;min-height:390px;border:1px solid var(--line)}
body:has(.brand-scene) .brands .brand{display:none}
</style>
